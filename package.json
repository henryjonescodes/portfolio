{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "export-sass-variables": "node ./scripts/export-sass-variables.js",
    "generate-terminal-qr-code": "node ./scripts/generate-terminal-qr-code.js",
    "dev": "npm run generate-terminal-qr-code && vite",
    "dev-export": "npm run export-sass-variables && npm run dev",
    "build": "npm run export-sass-variables && tsc -b && vite build && npm run share-data",
    "share-data": "node scripts/build-share-data.mjs",
    "lint": "eslint src",
    "format": "prettier --write src e2e",
    "test:e2e": "playwright test",
    "check": "npm run lint && tsc -b && knip && npm run check:assets && npm run check:mentions",
    "check:assets": "node scripts/check-assets.mjs",
    "check:mentions": "node scripts/check-mentions.mjs",
    "requests": "node scripts/build-requests.mjs",
    "modal-frames": "node scripts/capture-modal-frames.mjs",
    "og-image": "node scripts/capture-og-image.mjs"
  },
  "dependencies": {
    "@react-spring/three": "^9.7.5",
    "@react-three/drei": "^9.114.5",
    "@react-three/fiber": "^8.17.10",
    "classnames": "^2.5.1",
    "colord": "^2.9.3",
    "framer-motion": "^11.11.9",
    "its-fine": "^1.2.5",
    "leva": "^0.10.1",
    "react": "^18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1",
    "vite-plugin-svgr": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "knip": "^5.88.1",
    "prettier": "^3.8.1",
    "qrcode-terminal": "^0.12.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.81.0",
    "sass-export": "^2.1.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vite-plugin-compression": "^0.5.1"
  }
}
